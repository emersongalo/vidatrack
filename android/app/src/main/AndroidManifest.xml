<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Etapa 121: link de volta do login com Google. Sem isso,
                 depois de fazer login no navegador do Google, o Android
                 não sabe que é pra voltar pro nosso app — esse esquema
                 (vidatrack://) é só nosso, então o sistema sabe abrir o
                 VidaTrack de novo em vez de deixar parado no navegador. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vidatrack" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Etapa 152: widget de tela inicial "Hoje" (contagem de
             hábitos). Registrado aqui pro Android saber que esse
             widget existe e como redesenhá-lo. -->
        <receiver
            android:name="com.vidatrack.app.widget.HojeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hoje_widget_info" />
        </receiver>

        <!-- Etapa 154: mais três widgets, mesmo padrão. -->
        <receiver
            android:name="com.vidatrack.app.widget.SaldoWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/saldo_widget_info" />
        </receiver>

        <receiver
            android:name="com.vidatrack.app.widget.ContasAPagarWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/contas_widget_info" />
        </receiver>

        <receiver
            android:name="com.vidatrack.app.widget.PendenciasWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pendencias_widget_info" />
        </receiver>
    </application>
    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
