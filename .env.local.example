# URL onde o app está rodando (usada no login com Google e no e-mail de redefinição de senha)
# Local: http://localhost:3000
# Produção: a URL do seu projeto no Vercel, ex: https://vidatrack.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — em Project Settings > API no seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço do Supabase — NUNCA prefixar com NEXT_PUBLIC (ficaria
# exposta no navegador). Usada só pela rota de lembretes automáticos.
# Fica em Project Settings > API > service_role (clique em "Reveal")
SUPABASE_SERVICE_ROLE_KEY=

# Notificações push (VAPID) — gere com: npm run gerar-chaves-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Segredo que só o seu agendador externo conhece, pra proteger a rota
# /api/lembretes de ser chamada por qualquer um. Invente uma string
# aleatória longa.
CRON_SECRET=

# Notificação push nativa (FCM) — pro app publicado na Play Store.
# Veja o passo a passo completo no README ("Configurar notificação
# push nativa"). O valor é o JSON da conta de serviço do Firebase,
# codificado em base64 (não cole o JSON direto aqui).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Fuso horário do servidor em relação ao seu, em horas (Brasília = -3).
# Só mexa nisso se você não estiver no fuso de Brasília.
TIMEZONE_OFFSET_HORAS=-3

# Cloudflare R2 (armazenamento de arquivos e fotos das Notas)
# Veja o README para o passo a passo de onde pegar cada valor
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
